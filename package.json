{
  "name": "opentake",
  "version": "0.2.0-beta.1",
  "description": "Opentake: a self-hosted desktop app for turning investing ideas into rules and trades on your own brokerage accounts",
  "main": "./out/main/index.js",
  "author": "Earlybird <founders@joinearlybird.com>",
  "license": "MIT",
  "homepage": "https://github.com/Try-Early-Bird/opentake",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Try-Early-Bird/opentake.git"
  },
  "bugs": "https://github.com/Try-Early-Bird/opentake/issues",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "build:prod": "npm run build && electron-builder --publish never",
    "build:release": "npm run build && electron-builder --config electron-builder.release.cjs --publish never",
    "build:unpacked": "npm run build && electron-builder --dir --publish never",
    "start": "electron-vite preview",
    "package": "npm run build:prod",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit tests/chat/unit",
    "test:connections": "vitest run tests/unit/migrations.test.ts tests/unit/connections.test.ts tests/unit/robinhood.test.ts",
    "test:connections:ui": "npm run build && node --test --test-name-pattern='Robinhood connection menu and migration history' tests/electron.test.mjs",
    "test:host": "vitest run tests/unit/host-rpc.test.ts tests/unit/maintenance.test.ts",
    "test:host:ui": "npm run build && node --test tests/host.test.mjs",
    "test:pglite": "vitest run tests/pglite.test.mjs",
    "test:recovery": "node --test tests/recovery.test.mjs",
    "test:shutdown": "npm run build && node --test tests/shutdown.test.mjs",
    "check": "npm test && npm run test:recovery && npm run test:smoke",
    "test:smoke": "npm run build && node --test tests/electron.test.mjs tests/shutdown.test.mjs tests/host.test.mjs tests/app-updates.test.mjs",
    "postinstall": "node scripts/prepare-ai-runtime.cjs",
    "test:chat:unit": "vitest run tests/chat/unit tests/unit/host-rpc.test.ts",
    "test:chat:integration": "npm run build && node --test --test-concurrency=1 tests/chat/integration/*.test.mjs",
    "test:chat": "npm run test:chat:unit && npm run test:chat:integration",
    "verify:startup": "vitest run tests/unit/startup-guard.test.ts tests/unit/migration-lineage.test.ts tests/unit/tool-governance-startup.test.ts",
    "predev": "npm run verify:startup",
    "test:startup": "npm run build && node --test tests/startup.test.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.31",
    "@base-ui/react": "^1.9.0",
    "@coinbase/coinbase-cli": "0.0.10",
    "@electric-sql/pglite": "^0.5.11",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "1.0.13",
    "@tanstack/react-router": "^1.170.46",
    "ajv": "8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "conf": "^16.0.0",
    "cryptocurrency-icons": "0.18.1",
    "electron-updater": "^6.8.11",
    "emoji-picker-react": "^5.1.0",
    "image-size": "2.0.4",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "react-idle-timer": "^5.7.3",
    "recharts": "^3.10.1",
    "semver": "^7.8.5",
    "sharp": "0.35.5",
    "streamdown": "2.7.1",
    "tailwind-merge": "^3.3.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "build": {
    "appId": "local.earlybird.oss",
    "productName": "Opentake",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "category": "public.app-category.finance"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Finance"
    },
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/@coinbase/coinbase-cli/**",
      "node_modules/@napi-rs/**"
    ],
    "beforePack": "scripts/prepare-ai-runtime.cjs"
  }
}
